{
  "sourceLanguage": "en",
  "strings": {
    "shareSheetTitle": {
      "comment": "Title of the sheet that opens over another app when something is shared to Anchor; it names the note the sheet makes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Notiz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New note"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa notatka"
          }
        }
      }
    },
    "noteTitleHint": {
      "comment": "Placeholder of the note title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł"
          }
        }
      }
    },
    "editorPlaceholder": {
      "comment": "Placeholder in an empty note.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib los"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start writing"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij pisać"
          }
        }
      }
    },
    "commonCancel": {
      "comment": "Button that closes a dialog, sheet, search or selection without making changes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj"
          }
        }
      }
    },
    "commonSave": {
      "comment": "Button that saves a form or the choice made in a sheet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz"
          }
        }
      }
    },
    "commonClose": {
      "comment": "Spoken label of the picture viewer’s close button and of the area outside a dialog, and the button that closes the share sheet when nothing in a share can be saved.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij"
          }
        }
      }
    },
    "shareSignIn": {
      "comment": "Shown in the sheet that opens when something is shared to Anchor from another app while no one is signed in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei Anchor an, um zu speichern, was du teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Anchor to save what you share."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do Anchor, aby zapisać to, co udostępniasz."
          }
        }
      }
    },
    "shareNothing": {
      "comment": "Shown in the share sheet when what another app shared has nothing Anchor can keep.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es nichts, was Anchor speichern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s nothing here that Anchor can save."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu nic, co Anchor mógłby zapisać."
          }
        }
      }
    },
    "shareNotAdded": {
      "comment": "Shown below the new note in the share sheet when some shared files can’t come in, for mixed or unknown reasons.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 Datei konnte nicht hinzugefügt werden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Dateien konnten nicht hinzugefügt werden."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 file couldn’t be added."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files couldn’t be added."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie udało się dodać 1 pliku."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie udało się dodać %lld plików."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie udało się dodać %lld plików."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie udało się dodać %lld pliku."
                }
              }
            }
          }
        }
      }
    },
    "shareUnsupported": {
      "comment": "Shown below the new note in the share sheet when shared files are of a kind Anchor doesn’t keep, such as a video or a PDF.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 Datei kann nicht hinzugefügt werden. Anchor nimmt Bilder und Audio auf."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Dateien können nicht hinzugefügt werden. Anchor nimmt Bilder und Audio auf."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 file can’t be added. Anchor adds pictures and audio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files can’t be added. Anchor adds pictures and audio."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie można dodać 1 pliku. Anchor dodaje obrazy i dźwięk."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie można dodać %lld plików. Anchor dodaje obrazy i dźwięk."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie można dodać %lld plików. Anchor dodaje obrazy i dźwięk."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nie można dodać %lld pliku. Anchor dodaje obrazy i dźwięk."
                }
              }
            }
          }
        }
      }
    },
    "shareTooBig": {
      "comment": "Shown below the new note in the share sheet when shared files are larger than a note’s file limit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 Datei ist größer als 50 MB und kann nicht hinzugefügt werden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Dateien sind größer als 50 MB und können nicht hinzugefügt werden."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 file is over 50 MB, so it can’t be added."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files are over 50 MB, so they can’t be added."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 plik ma ponad 50 MB, więc nie można go dodać."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pliki mają ponad 50 MB, więc nie można ich dodać."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plików ma ponad 50 MB, więc nie można ich dodać."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pliku ma ponad 50 MB, więc nie można ich dodać."
                }
              }
            }
          }
        }
      }
    },
    "shareOverLimit": {
      "comment": "Shown below the new note in the share sheet when more than 20 files were shared at once.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten 20 Dateien werden hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the first 20 files are added."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano tylko pierwszych 20 plików."
          }
        }
      }
    },
    "shareRemoveItem": {
      "comment": "Spoken label of the small x on a picture or audio file in the share sheet; it leaves that file out of the new note.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń: %@"
          }
        }
      }
    },
    "shareTag": {
      "comment": "Spoken label of a tag in the share sheet; tapping it adds the tag to the new note or takes it off.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
