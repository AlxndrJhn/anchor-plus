{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!pnpm-lock.yaml",
      "!app/styles/tokens.css",
      "!app/styles/notes.css",
      "!lib/design/tokens.ts",
      "!app/styles/schemes.css",
      "!lib/design/schemes.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/navigation": {
                "importNames": ["useParams"],
                "message": "The static build has one page per dynamic route (e.g. /notes/new for every note), so useParams() returns its placeholder in production. Read the id from the address with useRouteId() from @/lib/route-id."
              }
            }
          }
        },
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "a11y": {
        "useMediaCaption": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
